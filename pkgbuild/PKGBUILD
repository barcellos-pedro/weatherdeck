pkgname=weatherdeck
pkgver=0.1.0
pkgrel=1
pkgdesc='A keyboard-first weather dashboard for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()
build() { cd "$startdir/.."; ./bin/build; }
package() { cd "$startdir/.."; install -Dm755 build/weatherdeck "$pkgdir/usr/bin/weatherdeck"; install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; install -Dm644 "$startdir/weatherdeck.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/weatherdeck.svg"; install -Dm644 "$startdir/weatherdeck.desktop" "$pkgdir/usr/share/applications/weatherdeck.desktop"; }
